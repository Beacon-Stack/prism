# Beacon-stack unified build — context is the beacon/ root directory.
# This variant copies the Pulse SDK for the local replace directive.

# ── Frontend build stage ──────────────────────────────────────────────────────
FROM node:22-alpine AS frontend

WORKDIR /app/web/ui

COPY prism/web/ui/package.json prism/web/ui/package-lock.json ./
RUN npm ci

COPY prism/web/ui/ ./

# Shared UI components (Modal, ConfirmDialog). See web-shared/README.md.
COPY web-shared/ /web-shared/
RUN cd /web-shared && npm install --no-audit --no-fund --loglevel=error

RUN npm run build

# ── Go build stage ───────────────────────────────────────────────────────────
FROM golang:1.25-alpine AS builder

ARG VERSION=dev
ARG TMDB_API_KEY
ARG TRAKT_CLIENT_ID

WORKDIR /app

# Copy Pulse SDK for local replace directive
COPY pulse/ /pulse/

# Copy all Prism source
COPY prism/ .

# Rewrite replace directive to point to copied Pulse SDK
RUN sed -i 's|replace github.com/beacon-stack/pulse => .*|replace github.com/beacon-stack/pulse => /pulse|' go.mod

RUN go mod download

# Overwrite web/static/ with the freshly built frontend
COPY --from=frontend /app/web/static/ ./web/static/

# Guard against silent keyless builds — see pilot/docker/Dockerfile.beacon
# for rationale.
RUN [ -n "${TMDB_API_KEY}" ] || (echo >&2 "ERROR: TMDB_API_KEY is empty. Refusing to bake a keyless binary. Set PRISM_TMDB_API_KEY in your shell before rebuilding." && exit 1)

# XOR-obfuscate the provider keys before baking them into the binary.
# See pilot/docker/Dockerfile.beacon for the rationale.
RUN TMDB_LDFLAGS="$(go run ./tools/obfuscate obfuscatedTMDBKey tmdbKeyXORKey "${TMDB_API_KEY}")" && \
    TRAKT_LDFLAGS="$(go run ./tools/obfuscate obfuscatedTraktClientID traktClientIDXORKey "${TRAKT_CLIENT_ID}")" && \
    CGO_ENABLED=0 GOOS=linux go build \
      -ldflags "-X github.com/beacon-stack/prism/internal/version.Version=${VERSION} \
                ${TMDB_LDFLAGS} \
                ${TRAKT_LDFLAGS} \
                -s -w" \
      -o /prism ./cmd/prism

# ── Final stage ───────────────────────────────────────────────────────────────
FROM alpine:3.21

RUN apk add --no-cache ffmpeg ca-certificates tzdata && \
    adduser -D -u 1000 prism

COPY --from=builder /prism /prism

# Beacon-stack-shaped defaults — match docker/Dockerfile so the local
# dev image is interchangeable with the published ghcr.io/beacon-stack
# image. The database is an embedded SQLite file on the /config volume.
# compose `environment:` overrides still win.
ENV PRISM_DATABASE_PATH=/config/prism.db \
    PRISM_PULSE_URL=http://pulse:9696 \
    PRISM_LOG_LEVEL=info \
    TZ=UTC

VOLUME ["/config"]
EXPOSE 8282

USER prism
ENTRYPOINT ["/prism"]
