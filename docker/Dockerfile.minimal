# ── Build stage ───────────────────────────────────────────────────────────────
FROM golang:1.25-alpine AS builder

ARG VERSION=dev
ARG BUILD_TIME=unknown
ARG TMDB_API_KEY
ARG TRAKT_CLIENT_ID

WORKDIR /app

# Download dependencies first (cached unless go.mod/go.sum change)
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# XOR-obfuscate provider keys (see docker/Dockerfile for rationale).
RUN TMDB_LDFLAGS="$(go run ./tools/obfuscate obfuscatedTMDBKey tmdbKeyXORKey "${TMDB_API_KEY}")" && \
    TRAKT_LDFLAGS="$(go run ./tools/obfuscate obfuscatedTraktClientID traktClientIDXORKey "${TRAKT_CLIENT_ID}")" && \
    CGO_ENABLED=0 GOOS=linux go build \
      -ldflags "-X github.com/beacon-stack/prism/internal/version.Version=${VERSION} \
                -X github.com/beacon-stack/prism/internal/version.BuildTime=${BUILD_TIME} \
                ${TMDB_LDFLAGS} \
                ${TRAKT_LDFLAGS} \
                -s -w" \
      -o /prism ./cmd/prism

# Create a minimal /etc/passwd so the scratch image has a non-root user.
# UID/GID 65532 matches the distroless "nonroot" convention.
RUN echo "nonroot:x:65532:65532:nonroot:/:/sbin/nologin" > /etc/passwd.prism && \
    echo "nonroot:x:65532:" > /etc/group.prism

# ── Final stage ───────────────────────────────────────────────────────────────
# scratch: zero OS footprint. No ffprobe — media scanning requires host-side
# ffprobe. Use the default image (docker/Dockerfile) if you need ffprobe.
FROM scratch

# TLS root certificates (needed for outbound HTTPS: TMDB, indexers, Claude API)
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

# Minimal passwd/group so the process can run as a named non-root user.
COPY --from=builder /etc/passwd.prism /etc/passwd
COPY --from=builder /etc/group.prism /etc/group

# The binary
COPY --from=builder /prism /prism

# Beacon-stack-shaped defaults (see docker/Dockerfile for rationale).
ENV PRISM_DATABASE_DRIVER=postgres \
    PRISM_DATABASE_DSN="postgres://prism@postgres:5432/prism_db?sslmode=disable" \
    PRISM_DATABASE_PASSWORD_FILE=/run/secrets/prism.txt \
    PRISM_PULSE_URL=http://pulse:9696 \
    PRISM_PULSE_API_KEY_FILE=/run/secrets/pulse-api-key.txt \
    PRISM_LOG_LEVEL=info \
    TZ=UTC

# Default data directory (mount a volume here in production)
VOLUME ["/config"]

EXPOSE 8282

# Run as non-root. The /config volume must be owned by UID 65532 on the host,
# or mounted with appropriate permissions, for the process to write to it.
USER nonroot:nonroot

ENTRYPOINT ["/prism"]
